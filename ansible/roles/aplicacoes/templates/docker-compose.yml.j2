# {{ ansible_managed }}
# Camada de aplicação: um container Nginx (HTML estático) por aplicação.
name: sd-aplicacoes

services:
{% for app in aplicacoes %}
  {{ app.id }}:
    image: nginx:1.27-alpine
    container_name: {{ app.id }}
    hostname: {{ app.id }}
    restart: unless-stopped
    ports:
      - "{{ app.porta }}:80"
    volumes:
      - ./app.conf:/etc/nginx/conf.d/default.conf:ro
      - ./{{ app.id }}:/usr/share/nginx/html:ro
{% endfor %}
