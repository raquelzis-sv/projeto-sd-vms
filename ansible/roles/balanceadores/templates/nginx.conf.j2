# {{ ansible_managed }}
# Balanceador {{ lb_nome }} — Round-Robin entre as {{ aplicacoes | length }} aplicações.

upstream aplicacoes {
    # Sem diretiva de algoritmo = Round-Robin (padrão do Nginx)
{% for app in aplicacoes %}
    server {{ apps_host }}:{{ app.porta }} max_fails=1 fail_timeout=5s;   # {{ app.nome }}
{% endfor %}
}

server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://aplicacoes;

        # Header injetado na requisição repassada para a aplicação
        proxy_set_header X-Balancer-Used {{ lb_nome }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        # Também devolvido ao cliente, para conferir com curl -I
        add_header X-Balancer-Used {{ lb_nome }} always;
        add_header X-Upstream-Addr $upstream_addr always;

        proxy_connect_timeout 2s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "{{ lb_nome }} ok\n";
    }
}
