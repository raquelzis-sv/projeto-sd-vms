# {{ ansible_managed }}
# Balanceador {{ lb_nome }}: Nginx + Keepalived.
# network_mode host: o Keepalived coloca o VIP direto na placa de rede da VM.
name: sd-balanceador

services:
  {{ lb_nome | lower }}:
    build: .
    image: sd/balanceador:latest
    container_name: {{ lb_nome | lower }}
    hostname: {{ lb_nome | lower }}
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_BROADCAST
      - NET_RAW
    restart: unless-stopped
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./keepalived.conf:/etc/keepalived/keepalived.conf:ro
